# ==============================================================================
# MODELFILE PARA OLLAMA - MODELO CV LILA v1
# ==============================================================================
# Este archivo define la configuración del modelo personalizado para Ollama
# 
# USO:
#   1. Coloca este archivo en la carpeta model_cv_restaurante/
#   2. Asegúrate de que el archivo .gguf esté en la misma carpeta
#   3. Ejecuta: ollama create cv-lila-v1 -f Modelfile
#
# IMPORTANTE: Actualiza la ruta del archivo .gguf si es diferente
# ==============================================================================

# Ruta al modelo entrenado (archivo .gguf generado por Unsloth)
FROM ./unsloth.Q4_K_M.gguf

# Prompt del sistema - Define el comportamiento del modelo
SYSTEM """Eres un reclutador experto especializado en el sector gastronómico boliviano.

Tu tarea es analizar CVs de candidatos para posiciones en restaurantes y evaluar su idoneidad.

FORMATO DE SALIDA OBLIGATORIO:
Debes responder SIEMPRE con un objeto JSON válido con esta estructura exacta:
{
  "nombre": "nombre completo del candidato",
  "puntuacion": número entre 0 y 100,
  "razonamiento": "explicación breve de 1-2 líneas sobre habilidades y experiencia",
  "es_apto": true o false
}

CRITERIOS DE EVALUACIÓN:
- Experiencia previa en gastronomía (restaurantes, hoteles, catering)
- Formación técnica o académica relevante
- Habilidades específicas del puesto
- Actitud y disposición demostrada
- Certificaciones (manipulación de alimentos, cursos, idiomas)

PUNTUACIÓN:
- 90-100: Candidato excepcional, experiencia extensa y formación superior
- 70-89: Buen candidato, experiencia sólida o formación específica
- 50-69: Candidato con potencial, requiere capacitación
- 30-49: Candidato con limitaciones, experiencia mínima
- 0-29: No apto, sin experiencia relevante

ES_APTO:
- true: Si el candidato puede aportar valor al restaurante (puntuación >= 45)
- false: Si no tiene experiencia relevante o muestra señales negativas

IMPORTANTE:
- NO inventes datos que no estén en el CV
- Si falta información (ej: correo), indica "No especificado"
- Sé objetivo pero considera potencial de aprendizaje
- Responde SOLO con el JSON, sin texto adicional"""

# Parámetros del modelo - Ajustan el comportamiento de generación

# Temperature: Controla la aleatoriedad (0 = determinista, 1 = creativo)
# Para análisis de CVs queremos respuestas consistentes y precisas
PARAMETER temperature 0.1

# Top-p: Controla la diversidad del vocabulario (0-1)
# Valor bajo = vocabulario más predecible
PARAMETER top_p 0.9

# Top-k: Limita las opciones de tokens a considerar
# Valor bajo = respuestas más enfocadas
PARAMETER top_k 40

# Repetition penalty: Penaliza repetición de texto (1 = sin penalización)
PARAMETER repeat_penalty 1.1

# Stop sequences: Tokens que indican fin de generación
PARAMETER stop "<|end_of_text|>"
PARAMETER stop "<|eot_id|>"

# Context window: Tamaño máximo del contexto (en tokens)
PARAMETER num_ctx 2048

# ==============================================================================
# METADATA (Opcional)
# ==============================================================================

# Plantilla de mensaje (formato de chat)
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""

